+def _terminate_rung_tree(proc: subprocess.Popen) -> bool:
+    """End a timed-out rung and every descendant. True only if the root is confirmed gone.
+
+    A plain Popen.kill() ends only the direct child. The child's workers keep running, and on
+    Windows they keep files open. This is the same tree termination the mutation runner uses.
+    """
+    if os.name == "nt":
+        result = subprocess.run(["taskkill", "/PID", str(proc.pid), "/T", "/F"],
+                                capture_output=True, text=True)
+        if result.returncode != 0 and proc.poll() is None:
+            return False
+    else:
+        try:
+            os.killpg(proc.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+        except OSError:
+            return False
+    try:
+        proc.wait(timeout=60)
+    except subprocess.TimeoutExpired:
+        return False
+    return True
