index 00000000..12c2804a
--- /dev/null
+++ b/tests/test_factory_guard_validator_paths.py
@@ -0,0 +1,45 @@
+"""The protected-path guard must cover the validator entrypoint, its configuration and its harness.
+
+Only the mutation rung was protected before this change: `harness/mutations/*`. The validator
+entrypoint (`harness/ci.py`), its configuration (`harness/harness.config.json`) and the E2E
+harness it runs were not, so an autonomous change to them would pass the structural guard.
+"""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+GUARD = Path(__file__).resolve().parents[1] / "factory" / "guard.py"
+
+
+def _guard():
+    spec = importlib.util.spec_from_file_location("factory_guard_under_test", GUARD)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.mark.parametrize("path", [
+    "harness/ci.py",
+    "harness/harness.config.json",
+    "harness/e2e.py",
+    "harness/appproc.py",
+    "harness/mutations/run.py",
+    "harness/mutations/defects.json",
+    "harness/fixtures/some_fixture.json",
+])
+def test_validator_entrypoint_config_and_harness_are_protected(path):
+    guard = _guard()
+    assert guard.matches(path, guard.PROTECTED), f"{path} is not a protected path"
+
+
+@pytest.mark.parametrize("path", [
+    "src/auteur/beginner/server.py",
+    "tests/test_mutation_runner_failure_paths.py",
+    "docs/narrative-architecture.md",
+])
+def test_ordinary_product_paths_are_not_protected(path):
+    guard = _guard()
+    assert not guard.matches(path, guard.PROTECTED), f"{path} is unexpectedly protected"
diff --git a/tests/test_outer_rung_termination.py b/tests/test_outer_rung_termination.py
new file mode 100644
index 00000000..2f57be51
--- /dev/null
+++ b/tests/test_outer_rung_termination.py
@@ -0,0 +1,112 @@
+"""Does the outer validator's `run()` (harness/ci.py) return and reclaim its workers at its deadline?
+
+The mutation rung is executed through `run()`, which calls subprocess.run(..., capture_output=True,
+timeout=...). On timeout that call kills only the direct child. A descendant that inherited the
+captured pipe can keep the call blocked, and it keeps running. These tests measure both effects with
+the real helper rather than assuming them.
+"""
+from __future__ import annotations
+
+import importlib.util
+import sys
+import time
+from pathlib import Path
+
+
+CI = Path(__file__).resolve().parents[1] / "harness" / "ci.py"
+
+PARENT = r'''
+import subprocess, sys, time
+# The grandchild inherits this process's stdout, which the caller captures through a pipe.
+subprocess.Popen([sys.executable, "-c",
+                  "import time,pathlib,sys; time.sleep(12); pathlib.Path(sys.argv[1]).write_text('alive')",
+                  sys.argv[1]])
+time.sleep(120)
+'''
+
+
+def _ci():
+    spec = importlib.util.spec_from_file_location("validator_ci_under_test", CI)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def test_outer_run_returns_at_its_deadline_even_with_a_descendant_holding_the_pipe(tmp_path, monkeypatch):
+    ci = _ci()
+    parent = tmp_path / "parent.py"
+    parent.write_text(PARENT, encoding="utf-8")
+    sentinel = tmp_path / "grandchild-finished.txt"
+    start = time.monotonic()
+    code, text = ci.run("mutations", [sys.executable, str(parent), str(sentinel)], timeout=3)
+    elapsed = time.monotonic() - start
+    assert code == 124 and "TIMEOUT after 3s" in text
+    # A deadline of 3 s must return within a few seconds. If the held pipe blocks the call, this
+    # measures how long the outer validator stalls instead.
+    assert elapsed < 10, f"outer run() blocked for {elapsed:.1f}s after a 3s deadline"
+
+
+def test_outer_run_reclaims_descendants_after_its_deadline(tmp_path):
+    ci = _ci()
+    parent = tmp_path / "parent.py"
+    parent.write_text(PARENT, encoding="utf-8")
+    sentinel = tmp_path / "grandchild-finished.txt"
+    ci.run("mutations", [sys.executable, str(parent), str(sentinel)], timeout=3)
+    # The grandchild writes the sentinel after 12 s if it is still alive.
+    time.sleep(16)
+    assert not sentinel.exists(), "a descendant of the timed-out outer rung kept running"
+
+
+# --- the rung's temporary output file: removed on success, cleanup failures reported ---------
+
+def _rung_files(scratch):
+    return sorted(p.name for p in scratch.iterdir() if p.name.startswith("rung-"))
+
+
+def test_successful_rung_leaves_no_temporary_output_file(tmp_path, monkeypatch):
+    import tempfile
+    ci = _ci()
+    scratch = tmp_path / "scratch"
+    scratch.mkdir()
+    monkeypatch.setattr(tempfile, "tempdir", str(scratch))
+    code, text = ci.run("unit", [sys.executable, "-c", "print('ok')"], timeout=60)
+    assert code == 0 and "ok" in text
+    assert _rung_files(scratch) == [], "a successful rung left its output file behind"
+
+
+def _refuse_rung_unlink(monkeypatch):
+    real_unlink = Path.unlink
+
+    def unlink(self, *args, **kwargs):
+        if self.name.startswith("rung-"):
+            raise PermissionError("output file held by another process")
+        return real_unlink(self, *args, **kwargs)
+
+    monkeypatch.setattr(Path, "unlink", unlink)
+
+
+def test_failed_rung_keeps_its_own_diagnosis_and_reports_the_cleanup_failure(tmp_path, monkeypatch):
+    import tempfile
+    ci = _ci()
+    scratch = tmp_path / "scratch"
+    scratch.mkdir()
+    monkeypatch.setattr(tempfile, "tempdir", str(scratch))
+    _refuse_rung_unlink(monkeypatch)
+    code, text = ci.run("unit", [sys.executable, "-c",
+                                 "import sys; print('PRIMARY DIAGNOSIS: 2 tests failed'); sys.exit(3)"],
+                        timeout=60)
+    assert code == 3, "the rung's own failure code must be preserved"
+    assert "PRIMARY DIAGNOSIS: 2 tests failed" in text, "the original diagnosis must survive"
+    assert "CLEANUP" in text and "PermissionError" in text, "the cleanup failure must be reported"
+
+
+def test_successful_rung_with_a_cleanup_failure_is_not_reported_as_success(tmp_path, monkeypatch):
+    import tempfile
+    ci = _ci()
+    scratch = tmp_path / "scratch"
+    scratch.mkdir()
+    monkeypatch.setattr(tempfile, "tempdir", str(scratch))
+    _refuse_rung_unlink(monkeypatch)
+    code, text = ci.run("unit", [sys.executable, "-c", "print('ok')"], timeout=60)
+    assert code != 0, "a gate whose output could not be cleaned up must not report success"
+    assert "CLEANUP" in text and "PermissionError" in text
