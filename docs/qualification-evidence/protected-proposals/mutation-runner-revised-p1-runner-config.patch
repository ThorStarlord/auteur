+def load_config() -> dict:
+    # Read from ROOT at call time so the budget always describes the tree the runner copies.
+    path = ROOT / "harness" / "harness.config.json"
+    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
+
+
+def mutant_budget_s() -> int:
+    """Upper bound for ONE mutant's inner gate.
+
+    The inner gate runs every rung that can fail (static, unit, e2e, holdout), and a
+    mutant caught by the unit rung needs that rung to run to completion. The bound is the
+    sum of the configured rungs plus a margin. It never raises the outer budget.
+    """
+    cfg = load_config()
+    rungs = sum(int(cfg.get(key, 0)) for key in ("static_timeout_s", "unit_timeout_s", "e2e_timeout_s"))
+    return rungs + int(cfg.get("mutation_margin_s", 120))
+
+
+def overhead_s() -> int:
+    """Time reserved per mutant for copying, cleanup and scheduling, outside the inner gate."""
+    return int(load_config().get("mutation_overhead_s", 120))
+
+
+def _terminate_tree(process: subprocess.Popen) -> bool:
+    """Terminate the inner gate and its descendants. Return True only if termination is confirmed.
+
+    Windows: `taskkill /T /F` ends the tree rooted at the process. Its return code is checked.
+    A return code of 128 means the root had already exited; that is accepted only if the
+    root is observed gone. Descendants re-parented before the kill cannot be enumerated by
+    /T, so a clean result here is a confirmation for the tree that was still attached.
+
+    POSIX: the child was started in its own session, so the whole group is killed.
+    """
+    if os.name == "nt":
+        result = subprocess.run(["taskkill", "/PID", str(process.pid), "/T", "/F"],
+                                capture_output=True, text=True)
+        if result.returncode != 0 and process.poll() is None:
+            return False
+        return True
+    try:
+        os.killpg(process.pid, signal.SIGKILL)
+    except ProcessLookupError:
+        pass
+    except OSError:
+        return False
+    return True
+
+
+def run_inner_gate(dest: Path, env: dict, timeout: int) -> tuple[str, int | None, str]:
+    """Run the inner gate once. Return (status, exit_code, output).
+
+    status is one of:
+      'exited'              the gate finished on its own; exit_code is its exit status
+      'timed_out'           the deadline passed and the tree was terminated and confirmed
+      'termination_failed'  the deadline passed and the tree could NOT be confirmed terminated
+    """
+    # Take the descriptor from mkstemp and close it immediately. Keeping it open would hold a
+    # Windows handle on a file that is about to be removed with the temporary tree.
+    fd, output_name = tempfile.mkstemp(prefix="inner-", suffix=".out", dir=dest.parent)
+    os.close(fd)
+    output_file = Path(output_name)
+    popen_options = {"start_new_session": True} if os.name != "nt" else {}
+    with output_file.open("wb") as out:
+        process = subprocess.Popen([sys.executable, "harness/ci.py"], cwd=dest, env=env,
+                                   stdout=out, stderr=subprocess.STDOUT, **popen_options)
+        try:
+            process.wait(timeout=timeout)
+            status, code = "exited", process.returncode
+        except subprocess.TimeoutExpired:
+            terminated = _terminate_tree(process)
+            try:
+                process.wait(timeout=60)
+                root_gone = True
+            except subprocess.TimeoutExpired:
+                root_gone = False
+            status = "timed_out" if (terminated and root_gone) else "termination_failed"
+            code = None
+    text = output_file.read_text(encoding="utf-8", errors="replace")
+    return status, code, text
+
