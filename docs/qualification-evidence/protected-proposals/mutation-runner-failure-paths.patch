+def load_config() -> dict:
+    # Read from ROOT at call time so the budget always describes the tree the runner copies.
+    path = ROOT / "harness" / "harness.config.json"
+    return json.loads(path.read_text(encoding="utf-8")) if path.exists() else {}
+
+
+def mutant_budget_s() -> int:
+    """Deadline for ONE mutant's inner gate.
+
+    The inner gate runs every rung that can fail (static, unit, e2e, holdout), and a
+    mutant caught by the unit rung needs that rung to run to completion. A fixed 600 s
+    cap was below the configured unit budget (900 s) and timed out the honest case.
+    The budget is therefore the sum of the configured rungs plus a margin.
+    """
+    cfg = load_config()
+    rungs = sum(int(cfg.get(key, 0)) for key in ("static_timeout_s", "unit_timeout_s", "e2e_timeout_s"))
+    return rungs + int(cfg.get("mutation_margin_s", 120))
+
+
+def _kill_tree(process: subprocess.Popen) -> None:
+    """Terminate the inner gate and every descendant, including pytest-xdist workers.
+
+    A plain Popen.kill() only ends the direct child; its workers keep files open under the
+    throwaway build, which is what made the temporary-directory cleanup fail on Windows.
+    """
+    if os.name == "nt":
+        subprocess.run(["taskkill", "/PID", str(process.pid), "/T", "/F"],
+                       capture_output=True, text=True)
+    else:
+        try:
+            os.killpg(process.pid, signal.SIGKILL)
+        except ProcessLookupError:
+            pass
+
+
+def run_inner_gate(dest: Path, env: dict, budget: int) -> tuple[str, int | None, str]:
+    """Return (status, exit_code, output). status is 'exited' or 'timed_out'."""
+    output_file = Path(tempfile.mkstemp(prefix="inner-", suffix=".out", dir=dest.parent)[1])
+    popen_options = {"start_new_session": True} if os.name != "nt" else {}
+    with output_file.open("wb") as out:
+        process = subprocess.Popen([sys.executable, "harness/ci.py"], cwd=dest, env=env,
+                                   stdout=out, stderr=subprocess.STDOUT, **popen_options)
+        try:
+            process.wait(timeout=budget)
+            status = "exited"
+        except subprocess.TimeoutExpired:
+            _kill_tree(process)
+            process.wait(timeout=60)
+            status = "timed_out"
+    # The file sits inside the throwaway temp root and is removed with it; an explicit unlink
+    # here can race a handle that is still closing on Windows.
+    text = output_file.read_text(encoding="utf-8", errors="replace")
+    return status, (None if status == "timed_out" else process.returncode), text
+
+
