{
  "forbidden": [
    ".env*",
    ".venv/**",
    "venv/**",
    "env/**",
    "dist/**",
    "build/**",
    "**/*.egg-info/**",
    "**/secrets.*",
    "**/*.key",
    "**/*.pem",
    "story_identity.yaml",
    "blueprint.yaml",
    ".auteur/**"
  ],
  "agents": {
