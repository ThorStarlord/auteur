__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/
# Reconciliation artifacts (written by BookReconciliationStore to project-relative paths)
# Includes inspections, proposals, plans, publications, previews, candidates, decisions, accepted-sources, and recompositions.
**/book/expression/reconciliation/

# Dogfood workspaces (regenerated by tests/scripts; must stay outside examples/
# and must never be committed -- see CanonicalStoryBootstrap.copy_to)
/temp/

# Agent/runner artifact directories (generated work products, never committed)
/artifacts/

# Scratch/development directories (agent scratchpads, brainstorm outputs)
.superpowers/

# Local pytest basetemp (required on hosts where the system temp-dir cleanup fails)
.pytest-tmp/

# Example temp/dogfood directories (regenerated from canonical example)
examples/canonical_story/temp_*/

# Windows temp files that sometimes get committed (glob-based, catches absolute paths)
*AppData/Local/Temp/*

# ReasoningRuntime report output (generated test artifacts)
reports/

# Root-level JSON files (test/report artifacts)
/*.json

# Generated project state directories (test artifacts, dogfood workspaces)
**/.auteur/

# Machine-specific local settings (proxy URLs, personal config)
**/.claude/settings.local.json

# Local qualification artifacts (pytest logs/XML, rejected-outcome and
# emotional-target runs) -- previously local-only in .git/info/exclude
/pytest-rejected-outcomes-parallel.log
/pytest-rejected-outcomes-parallel.xml
/pytest-rejected-outcomes-serial.log
/pytest-rejected-outcomes-serial.xml
/qualification-rejected-collect.txt
/pytest-emotional-targets-collect.txt
/pytest-emotional-targets-parallel.log
/pytest-emotional-targets-parallel.xml
/pytest-emotional-targets-serial.log
/pytest-emotional-targets-serial.xml
/pytest-emotional-targets-serial-retry.log
/pytest-emotional-targets-serial-retry.xml
/.qualification-emotional/
/pytest-cartographer-profile-emotions-collect-serial.txt
/pytest-cartographer-profile-emotions-collect-parallel.txt
/pytest-cartographer-profile-emotions-serial.log
/pytest-cartographer-profile-emotions-serial.xml
/pytest-cartographer-profile-emotions-parallel.log
/pytest-cartographer-profile-emotions-parallel.xml
/pytest-cartographer-profile-emotions-baseline-serial.log
/pytest-cartographer-profile-emotions-baseline-serial.xml
/pytest-cartographer-profile-emotions-serial-rerun1.log
/pytest-cartographer-profile-emotions-serial-rerun1.xml
/pytest-cartographer-profile-emotions-serial-A.log
/pytest-cartographer-profile-emotions-serial-A.xml
/pytest-cartographer-profile-emotions-serial-B.log
/pytest-cartographer-profile-emotions-serial-B.xml
/pytest-cartographer-postmerge-serial.log
/pytest-cartographer-postmerge-serial.xml
/pytest-cartographer-postmerge-parallel.log
/pytest-cartographer-postmerge-parallel.xml
/pytest-cartographer-replay-collect-serial.txt
/pytest-cartographer-replay-collect-parallel.txt
/pytest-cartographer-replay-serial.log
/pytest-cartographer-replay-serial.xml
/pytest-cartographer-replay-parallel.log
/pytest-cartographer-replay-parallel.xml
/.local/evaluations/cartographer/
/.local/evaluations/cartographer-agent-pilot/
/.worktrees/

# --- factory: credentials. The runner pre-flight asserts these; a git add -A
# must never be able to publish a credential-shaped file that appears later.
.env
.env.*
secrets.json
credentials.json
*.local
*credential*
*secret*
*.pem
*.key
id_rsa
id_ed25519
service-account.json
.archon/config.yaml
.archon/.env
config/secrets.yml

# --- factory runtime state: per-machine, regenerated, never meaningful in history
.factory/runs/
.factory/locks-runtime/
.factory/findings/
.factory/STOP
factory-*.log

# NOT ignored, deliberately:
#   .factory/locks/    the thresholds a human set - protected and tracked on purpose.
#   .factory/holdout/  tracked while it lives in-repo; the guard protects it on the diff.
#   .factory/prs/      the PR record on the file backend IS state, so it is tracked.

# --- factory: deploy snapshots (rebuildable from any sha)
builds/
