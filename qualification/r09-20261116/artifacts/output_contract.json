      "ArchitectureOpportunity": {
        "additionalProperties": false,
        "description": "A bounded, incidental creative possibility noticed while doing requested work.\n\nIt is not a defect, not a required author decision, and not narrative meaning.\nIt exists so an author can see a promising possibility without it displacing\nthe work they asked for.",
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_-]{0,79}$",
            "title": "Id",
            "type": "string"
          },
          "title": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "why_it_matters": {
            "maxLength": 600,
            "minLength": 1,
            "title": "Why It Matters",
            "type": "string"
          },
          "scope": {
            "default": "other",
            "enum": [
              "book",
              "series",
              "character",
              "relationship",
              "theme",
              "other"
            ],
            "title": "Scope",
            "type": "string"
          },
          "relationship": {
            "default": "unclear",
            "enum": [
              "deepens",
              "reinterprets",
              "replaces",
              "unclear"
            ],
            "title": "Relationship",
            "type": "string"
          },
          "artistic_potential": {
            "anyOf": [
              {
                "maxLength": 600,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Artistic Potential"
          },
          "intention_fidelity": {
            "anyOf": [
              {
                "maxLength": 600,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Intention Fidelity"
          },
          "requires_author_decision": {
            "default": false,
            "title": "Requires Author Decision",
            "type": "boolean"
          },
          "provisional_primary": {
            "default": false,
            "title": "Provisional Primary",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "why_it_matters"
        ],
        "title": "ArchitectureOpportunity",
        "type": "object"
      },
