{
  "schema": "auteur_host_agent_output_contract_v1",
  "version": 1,
  "model": "ArchitectureCandidate",
  "json_schema": {
    "$defs": {
      "ArchitectureInterpretation": {
        "additionalProperties": false,
        "description": "A consequential working interpretation the agent is using as if it were given.\n\nIt is not author-established. It exists so a load-bearing invention - a world\nrule, the meaning of an author commitment, or a proposed resolution of an\nauthor-reserved question - stays visible as a recommendation rather than being\nreported as settled narrative fact.",
        "properties": {
          "id": {
            "pattern": "^[a-z][a-z0-9_-]{0,79}$",
            "title": "Id",
            "type": "string"
          },
          "interpretation": {
            "maxLength": 800,
            "minLength": 1,
            "title": "Interpretation",
            "type": "string"
          },
          "affects": {
            "items": {
              "type": "string"
            },
            "maxItems": 12,
            "minItems": 1,
            "title": "Affects",
            "type": "array"
          },
          "consequences": {
            "maxLength": 800,
            "minLength": 1,
            "title": "Consequences",
            "type": "string"
          },
          "alternative": {
            "anyOf": [
              {
                "maxLength": 800,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Alternative"
          },
          "author_decision_required": {
            "default": false,
            "title": "Author Decision Required",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "interpretation",
          "affects",
          "consequences"
        ],
        "title": "ArchitectureInterpretation",
        "type": "object"
      },
